    def display_default_background(self):
        """显示默认背景（用于没有加载地图时显示机器人轨迹）"""
        # 清除场景
        self.graphics_scene.clear()

        # 设置默认场景大小（模拟地图大小）
        width, height = 1024, 1024
        self.graphics_scene.setSceneRect(0, 0, width, height)

        # 绘制网格线
        # 设置默认的ppm_map尺寸，以便坐标转换可以正常工作
        class DefaultMap:
            def __init__(self):
                self.mapWidth = 1024
                self.mapHeight = 1024

        self.default_map = DefaultMap()

        # 设置场景大小
        self.graphics_scene.setSceneRect(0, 0, self.default_map.mapWidth, self.default_map.mapHeight)
        grid_size = 50
        for x in range(0, width, grid_size):
            self.graphics_scene.addLine(x, 0, x, height, pen)
        for y in range(0, height, grid_size):
            self.graphics_scene.addLine(0, y, width, y, pen)

        for x in range(0, self.default_map.mapWidth, grid_size):
            self.graphics_scene.addLine(x, 0, x, self.default_map.mapHeight, pen)
        for y in range(0, self.default_map.mapHeight, grid_size):
            self.graphics_scene.addLine(0, y, self.default_map.mapWidth, y, pen)
        self.graphics_scene.addLine(width/2, 0, width/2, height, pen)  # Y轴

        # 添加坐标标签
        font = self.graphics_scene.font()
        self.graphics_scene.addLine(0, self.default_map.mapHeight/2, self.default_map.mapWidth, self.default_map.mapHeight/2, pen)  # X轴
        self.graphics_scene.addLine(self.default_map.mapWidth/2, 0, self.default_map.mapWidth/2, self.default_map.mapHeight, pen)  # Y轴
        # 中心点标签
        text = self.graphics_scene.addText("(0,0)", font)
        text.setPos(width/2 + 5, height/2 + 5)
        text.setDefaultTextColor(QColor(255, 0, 0, 128))

        # 角落标签
        text = self.graphics_scene.addText("(-512,-512)", font)
        text.setPos(self.default_map.mapWidth/2 + 5, self.default_map.mapHeight/2 + 5)
        text.setDefaultTextColor(QColor(255, 0, 0, 128))

        text = self.graphics_scene.addText("(511,511)", font)
        text.setPos(width - 80, 5)
        text.setPos(5, self.default_map.mapHeight - 20)

        # 设置默认的ppm_map尺寸，以便坐标转换可以正常工作
        class DefaultMap:
        text.setPos(self.default_map.mapWidth - 80, 5)
                self.mapWidth = 1024
                self.mapHeight = 1024
